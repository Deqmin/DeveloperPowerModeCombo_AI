{
  "manifest_version": 3,
  "name": "Developer Power Mode Combo",
  "version": "1.0.0",
  "description": "Arcade typing combos, neon sparks and pixel-art Corgis, Kitties and Octopuses. Local-only; never records what you type.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Developer Power Mode Combo",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/core.js",
        "src/sprites.js",
        "src/sim.js",
        "src/caret.js",
        "src/overlay.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
